# ===== DESTINO / DW (Railway) - credenciales del Grupo 1 =====
TARGET_DB_HOST=tokaido.proxy.rlwy.net
TARGET_DB_PORT=45049
TARGET_DB_NAME=sisg_analitica
TARGET_DB_USER=usr_grupo1
TARGET_DB_PASSWORD=COMPLETAR

# ===== ORIGEN: base operacional local SISG =====
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=sisg
SOURCE_DB_USER=root
SOURCE_DB_PASSWORD=

# ===== Vistas del DW (solo SELECT) =====
DW_FACT_VIEW=vw_g1_fact_atencion_privada
DW_CAT_TIEMPO_VIEW=vw_cat_tiempo
DW_CAT_ESTABLECIMIENTO_VIEW=vw_cat_establecimiento
DW_CAT_GEOGRAFIA_VIEW=vw_cat_geografia
DW_CAT_DIAGNOSTICO_VIEW=vw_cat_diagnostico
DW_CAT_ACTOR_VIEW=vw_cat_actor

# ===== Tabla buzon (solo INSERT) =====
DW_FACT_TABLE=ingesta_g1_atencion
DW_FACT_INSERT_COLUMNS=sk_tiempo,sk_establecimiento,sk_geografia,sk_diagnostico,atenciones,dias_estancia,monto_cobrado

# ===== Data Mart local (SQLite por defecto; puede ser otra URL SQLAlchemy) =====
DATAMART_URL=sqlite:///datamart_g1.db

# ===== Control =====
# false = simulacion (no inserta). true = inserta de verdad en el buzon.
ETL_ENABLE_LOAD=false
# Solo consultas con este estado cuentan como atencion (vacio = todas)
ETL_ESTADO_CONSULTA=ATENDIDA
